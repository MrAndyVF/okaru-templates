    "inactiveShimmer": "{{ colors.on_surface_variant.default.hex }}",
    "subtle": "{{ colors.outline_variant.default.hex }}",
    "suggestion": "{{ colors.secondary.default.hex }}",
    "remember": "{{ colors.secondary.default.hex }}",
    "permission": "{{ colors.tertiary.default.hex }}",
    "permissionShimmer": "{{ colors.tertiary.default.hex | auto_lightness 12 }}",
    "planMode": "{{ colors.secondary.default.hex }}",
    "autoAccept": "{{ colors.tertiary.default.hex }}",
    "autoAcceptShimmer": "{{ colors.tertiary.default.hex | auto_lightness 12 }}",
    "skill": "{{ colors.tertiary.default.hex }}",
    "ide": "{{ colors.secondary.default.hex }}",
    "bashBorder": "{{ colors.tertiary.default.hex }}",
    "promptBorder": "{{ colors.outline.default.hex }}",
    "promptBorderShimmer": "{{ colors.primary.default.hex }}",
    "success": "{{ colors.added.default.hex }}",
    "error": "{{ colors.error.default.hex }}",
    "warning": "{{ colors.caution.default.hex }}",
