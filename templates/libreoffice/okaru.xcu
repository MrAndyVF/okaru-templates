<?xml version="1.0" encoding="UTF-8"?>
<!-- OKARU: esquema de color desde la paleta activa. Los valores van en hex (RRGGBB); install.py los
     pasa al entero que pide el registro de LibreOffice. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="UI" oor:package="org.openoffice.Office">
  <node oor:name="ColorScheme">
    <node oor:name="ColorSchemes">
      <node oor:name="OKARU" oor:op="replace">
        <node oor:name="DocColor"><prop oor:name="Color"><value>{{ colors.surface.default.hex_stripped }}</value></prop></node>
        <node oor:name="DocBoundaries"><prop oor:name="Color"><value>{{ colors.outline_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="AppBackground"><prop oor:name="Color"><value>{{ colors.surface_container_low.default.hex_stripped }}</value></prop></node>
        <node oor:name="TableBoundaries"><prop oor:name="Color"><value>{{ colors.outline_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="FontColor"><prop oor:name="Color"><value>{{ colors.on_surface.default.hex_stripped }}</value></prop></node>
        <node oor:name="Links"><prop oor:name="IsVisible"><value>true</value></prop><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="LinksVisited"><prop oor:name="IsVisible"><value>true</value></prop><prop oor:name="Color"><value>{{ colors.tertiary.default.hex_stripped }}</value></prop></node>
        <node oor:name="Spell"><prop oor:name="Color"><value>{{ colors.error.default.hex_stripped }}</value></prop></node>
        <node oor:name="Grammar"><prop oor:name="Color"><value>{{ colors.caution.default.hex_stripped }}</value></prop></node>
        <node oor:name="SmartTags"><prop oor:name="Color"><value>{{ colors.tertiary.default.hex_stripped }}</value></prop></node>
        <node oor:name="Shadow"><prop oor:name="IsVisible"><value>true</value></prop><prop oor:name="Color"><value>{{ colors.shadow.default.hex_stripped }}</value></prop></node>
        <node oor:name="WriterTextGrid"><prop oor:name="Color"><value>{{ colors.outline_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="WriterBaselineGrid"><prop oor:name="Color"><value>{{ colors.outline_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="WriterFieldShadings"><prop oor:name="IsVisible"><value>true</value></prop><prop oor:name="Color"><value>{{ colors.surface_container_highest.default.hex_stripped }}</value></prop></node>
        <node oor:name="WriterIdxShadings"><prop oor:name="IsVisible"><value>true</value></prop><prop oor:name="Color"><value>{{ colors.surface_container_highest.default.hex_stripped }}</value></prop></node>
        <node oor:name="WriterDirectCursor"><prop oor:name="IsVisible"><value>true</value></prop><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="WriterSectionBoundaries"><prop oor:name="Color"><value>{{ colors.outline_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="WriterHeaderFooterMark"><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="WriterPageBreaks"><prop oor:name="Color"><value>{{ colors.tertiary.default.hex_stripped }}</value></prop></node>
        <node oor:name="WriterNonPrintChars"><prop oor:name="Color"><value>{{ colors.outline.default.hex_stripped }}</value></prop></node>
        <node oor:name="HTMLSGML"><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="HTMLComment"><prop oor:name="Color"><value>{{ colors.outline.default.hex_stripped }}</value></prop></node>
        <node oor:name="HTMLKeyword"><prop oor:name="Color"><value>{{ colors.secondary.default.hex_stripped }}</value></prop></node>
        <node oor:name="HTMLUnknown"><prop oor:name="Color"><value>{{ colors.error.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcGrid"><prop oor:name="Color"><value>{{ colors.outline_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcCellFocus"><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcDBFocus"><prop oor:name="Color"><value>{{ colors.tertiary.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcPageBreak"><prop oor:name="Color"><value>{{ colors.outline.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcPageBreakManual"><prop oor:name="Color"><value>{{ colors.secondary.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcPageBreakAutomatic"><prop oor:name="Color"><value>{{ colors.outline.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcHiddenColRow"><prop oor:name="IsVisible"><value>true</value></prop><prop oor:name="Color"><value>{{ colors.outline.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcTextOverflow"><prop oor:name="IsVisible"><value>true</value></prop><prop oor:name="Color"><value>{{ colors.error.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcComments"><prop oor:name="Color"><value>{{ colors.caution.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcDetective"><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcDetectiveError"><prop oor:name="Color"><value>{{ colors.error.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcReference"><prop oor:name="Color"><value>{{ colors.tertiary.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcNotesBackground"><prop oor:name="Color"><value>{{ colors.caution_container.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcValue"><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcFormula"><prop oor:name="Color"><value>{{ colors.added.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcText"><prop oor:name="Color"><value>{{ colors.on_surface.default.hex_stripped }}</value></prop></node>
        <node oor:name="CalcProtectedBackground"><prop oor:name="Color"><value>{{ colors.surface_container.default.hex_stripped }}</value></prop></node>
        <node oor:name="DrawGrid"><prop oor:name="IsVisible"><value>true</value></prop><prop oor:name="Color"><value>{{ colors.outline.default.hex_stripped }}</value></prop></node>
        <node oor:name="Author1"><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="Author2"><prop oor:name="Color"><value>{{ colors.secondary.default.hex_stripped }}</value></prop></node>
        <node oor:name="Author3"><prop oor:name="Color"><value>{{ colors.tertiary.default.hex_stripped }}</value></prop></node>
        <node oor:name="Author4"><prop oor:name="Color"><value>{{ colors.added.default.hex_stripped }}</value></prop></node>
        <node oor:name="Author5"><prop oor:name="Color"><value>{{ colors.caution.default.hex_stripped }}</value></prop></node>
        <node oor:name="Author6"><prop oor:name="Color"><value>{{ colors.error.default.hex_stripped }}</value></prop></node>
        <node oor:name="Author7"><prop oor:name="Color"><value>{{ colors.primary_fixed_dim.default.hex_stripped }}</value></prop></node>
        <node oor:name="Author8"><prop oor:name="Color"><value>{{ colors.secondary_fixed_dim.default.hex_stripped }}</value></prop></node>
        <node oor:name="Author9"><prop oor:name="Color"><value>{{ colors.tertiary_fixed_dim.default.hex_stripped }}</value></prop></node>
        <node oor:name="BASICEditor"><prop oor:name="Color"><value>{{ colors.surface.default.hex_stripped }}</value></prop></node>
        <node oor:name="BASICIdentifier"><prop oor:name="Color"><value>{{ colors.on_surface.default.hex_stripped }}</value></prop></node>
        <node oor:name="BASICComment"><prop oor:name="Color"><value>{{ colors.outline.default.hex_stripped }}</value></prop></node>
        <node oor:name="BASICNumber"><prop oor:name="Color"><value>{{ colors.tertiary.default.hex_stripped }}</value></prop></node>
        <node oor:name="BASICString"><prop oor:name="Color"><value>{{ colors.added.default.hex_stripped }}</value></prop></node>
        <node oor:name="BASICOperator"><prop oor:name="Color"><value>{{ colors.on_surface_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="BASICKeyword"><prop oor:name="Color"><value>{{ colors.secondary.default.hex_stripped }}</value></prop></node>
        <node oor:name="BASICError"><prop oor:name="Color"><value>{{ colors.error.default.hex_stripped }}</value></prop></node>
        <node oor:name="SQLIdentifier"><prop oor:name="Color"><value>{{ colors.on_surface.default.hex_stripped }}</value></prop></node>
        <node oor:name="SQLNumber"><prop oor:name="Color"><value>{{ colors.tertiary.default.hex_stripped }}</value></prop></node>
        <node oor:name="SQLString"><prop oor:name="Color"><value>{{ colors.added.default.hex_stripped }}</value></prop></node>
        <node oor:name="SQLOperator"><prop oor:name="Color"><value>{{ colors.on_surface_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="SQLKeyword"><prop oor:name="Color"><value>{{ colors.secondary.default.hex_stripped }}</value></prop></node>
        <node oor:name="SQLParameter"><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="SQLComment"><prop oor:name="Color"><value>{{ colors.outline.default.hex_stripped }}</value></prop></node>
        <node oor:name="WindowColor"><prop oor:name="Color"><value>{{ colors.surface_container.default.hex_stripped }}</value></prop></node>
        <node oor:name="WindowTextColor"><prop oor:name="Color"><value>{{ colors.on_surface.default.hex_stripped }}</value></prop></node>
        <node oor:name="BaseColor"><prop oor:name="Color"><value>{{ colors.surface_container_low.default.hex_stripped }}</value></prop></node>
        <node oor:name="ButtonColor"><prop oor:name="Color"><value>{{ colors.surface_container_high.default.hex_stripped }}</value></prop></node>
        <node oor:name="ButtonTextColor"><prop oor:name="Color"><value>{{ colors.on_surface.default.hex_stripped }}</value></prop></node>
        <node oor:name="AccentColor"><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="DisabledColor"><prop oor:name="Color"><value>{{ colors.surface_container.default.hex_stripped }}</value></prop></node>
        <node oor:name="DisabledTextColor"><prop oor:name="Color"><value>{{ colors.outline.default.hex_stripped }}</value></prop></node>
        <node oor:name="ShadowColor"><prop oor:name="Color"><value>{{ colors.shadow.default.hex_stripped }}</value></prop></node>
        <node oor:name="SeparatorColor"><prop oor:name="Color"><value>{{ colors.outline_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="FaceColor"><prop oor:name="Color"><value>{{ colors.surface_container.default.hex_stripped }}</value></prop></node>
        <node oor:name="ActiveColor"><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="ActiveTextColor"><prop oor:name="Color"><value>{{ colors.on_primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="ActiveBorderColor"><prop oor:name="Color"><value>{{ colors.primary.default.hex_stripped }}</value></prop></node>
        <node oor:name="FieldColor"><prop oor:name="Color"><value>{{ colors.surface_container_high.default.hex_stripped }}</value></prop></node>
        <node oor:name="MenuBarColor"><prop oor:name="Color"><value>{{ colors.surface_container.default.hex_stripped }}</value></prop></node>
        <node oor:name="MenuBarTextColor"><prop oor:name="Color"><value>{{ colors.on_surface.default.hex_stripped }}</value></prop></node>
        <node oor:name="MenuBarHighlightColor"><prop oor:name="Color"><value>{{ colors.secondary_container.default.hex_stripped }}</value></prop></node>
        <node oor:name="MenuBarHighlightTextColor"><prop oor:name="Color"><value>{{ colors.on_secondary_container.default.hex_stripped }}</value></prop></node>
        <node oor:name="MenuColor"><prop oor:name="Color"><value>{{ colors.surface_container_high.default.hex_stripped }}</value></prop></node>
        <node oor:name="MenuTextColor"><prop oor:name="Color"><value>{{ colors.on_surface.default.hex_stripped }}</value></prop></node>
        <node oor:name="MenuHighlightColor"><prop oor:name="Color"><value>{{ colors.secondary_container.default.hex_stripped }}</value></prop></node>
        <node oor:name="MenuHighlightTextColor"><prop oor:name="Color"><value>{{ colors.on_secondary_container.default.hex_stripped }}</value></prop></node>
        <node oor:name="MenuBorderColor"><prop oor:name="Color"><value>{{ colors.outline_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="InactiveColor"><prop oor:name="Color"><value>{{ colors.surface_container_low.default.hex_stripped }}</value></prop></node>
        <node oor:name="InactiveTextColor"><prop oor:name="Color"><value>{{ colors.on_surface_variant.default.hex_stripped }}</value></prop></node>
        <node oor:name="InactiveBorderColor"><prop oor:name="Color"><value>{{ colors.outline_variant.default.hex_stripped }}</value></prop></node>
      </node>
    </node>
  </node>
</oor:component-data>
