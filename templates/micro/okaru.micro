# OKARU: generado desde la paleta activa.
color-link default "{{ colors.on_surface.default.hex }},{{ colors.surface.default.hex }}"
color-link comment "italic {{ colors.outline.default.hex }}"
color-link identifier "{{ colors.primary.default.hex }}"
color-link constant "{{ colors.tertiary.default.hex }}"
color-link constant.string "{{ colors.added.default.hex }}"
color-link constant.string.char "{{ colors.added.default.hex }}"
color-link constant.number "{{ colors.tertiary.default.hex }}"
color-link statement "bold {{ colors.secondary.default.hex }}"
color-link symbol "{{ colors.on_surface_variant.default.hex }}"
color-link preproc "{{ colors.caution.default.hex }}"
color-link type "{{ colors.tertiary.default.hex }}"
color-link special "{{ colors.primary.default.hex }}"
color-link underlined "underline {{ colors.primary.default.hex }}"
color-link error "bold {{ colors.error.default.hex }}"
color-link todo "bold {{ colors.on_caution.default.hex }},{{ colors.caution.default.hex }}"
color-link hlsearch "{{ colors.on_tertiary_container.default.hex }},{{ colors.tertiary_container.default.hex }}"
color-link selection "{{ colors.on_primary_container.default.hex }},{{ colors.primary_container.default.hex }}"
color-link statusline "{{ colors.on_surface.default.hex }},{{ colors.surface_container_high.default.hex }}"
color-link statusline.inactive "{{ colors.outline.default.hex }},{{ colors.surface_container.default.hex }}"
color-link tabbar "{{ colors.on_surface_variant.default.hex }},{{ colors.surface_container.default.hex }}"
color-link tabbar.active "bold {{ colors.on_primary.default.hex }},{{ colors.primary.default.hex }}"
color-link indent-char "{{ colors.outline_variant.default.hex }}"
color-link line-number "{{ colors.outline.default.hex }},{{ colors.surface_container_low.default.hex }}"
color-link current-line-number "bold {{ colors.primary.default.hex }},{{ colors.surface_container_low.default.hex }}"
color-link cursor-line "{{ colors.surface_container.default.hex }}"
color-link color-column "{{ colors.surface_container.default.hex }}"
color-link gutter-error "{{ colors.error.default.hex }}"
color-link gutter-warning "{{ colors.caution.default.hex }}"
color-link diff-added "{{ colors.added.default.hex }}"
color-link diff-modified "{{ colors.caution.default.hex }}"
color-link diff-deleted "{{ colors.error.default.hex }}"
color-link divider "{{ colors.outline_variant.default.hex }},{{ colors.surface.default.hex }}"
color-link message "{{ colors.on_surface.default.hex }}"
color-link error-message "bold {{ colors.error.default.hex }}"
color-link match-brace "bold {{ colors.on_primary.default.hex }},{{ colors.primary.default.hex }}"
color-link scrollbar "{{ colors.outline_variant.default.hex }}"
color-link tab-error "{{ colors.error_container.default.hex }}"
color-link trailingws "{{ colors.error_container.default.hex }}"
