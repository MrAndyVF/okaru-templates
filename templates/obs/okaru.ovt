@OBSThemeMeta {
    name: 'OKARU';
    id: 'com.obsproject.Yami.OKARU';
    extends: '{{ mode | replace: "dark", "com.obsproject.Yami" | replace: "light", "com.obsproject.Yami.Light" }}';
    author: 'OKARU';
    dark: '{{ mode | replace: "dark", "true" | replace: "light", "false" }}';
}

@OBSThemeVars {
    --grey1: {{ colors.outline.default.hex }};
    --grey2: {{ colors.surface_bright.default.hex }};
    --grey3: {{ colors.surface_container_highest.default.hex }};
    --grey4: {{ colors.surface_container_high.default.hex }};
    --grey5: {{ colors.surface_container.default.hex }};
    --grey6: {{ colors.surface_container_low.default.hex }};
    --grey7: {{ colors.surface.default.hex }};
    --grey8: {{ colors.surface_container_lowest.default.hex }};

    --primary: {{ colors.primary.default.hex }};
    --primary_light: {{ colors.primary.default.hex | auto_lightness 8 }};
    --primary_lighter: {{ colors.primary.default.hex | auto_lightness 16 }};
    --primary_dark: {{ colors.primary_container.default.hex }};
    --primary_darker: {{ colors.primary_container.default.hex | darken 8 }};

    --bg_window: {{ colors.surface.default.hex }};
    --bg_base: {{ colors.surface_container.default.hex }};
    --bg_preview: {{ colors.surface_container_lowest.default.hex }};

    --text: {{ colors.on_surface.default.hex }};
    --text_light: {{ colors.on_surface.default.hex }};
    --text_muted: {{ colors.on_surface_variant.default.hex }};
    --text_disabled: {{ colors.outline.default.hex }};
    --text_inactive: {{ colors.on_surface_variant.default.hex }};

    --highlight_color: {{ colors.primary.default.hex }};
    --border_color: {{ colors.outline_variant.default.hex }};

    --input_bg: {{ colors.surface_container_high.default.hex }};
    --input_bg_hover: {{ colors.surface_container_highest.default.hex }};
    --input_bg_focus: {{ colors.surface_container_highest.default.hex }};
    --input_border_hover: {{ colors.outline.default.hex }};
    --input_border_focus: {{ colors.primary.default.hex }};
    --list_item_bg_selected: {{ colors.secondary_container.default.hex }};
    --list_item_bg_hover: {{ colors.surface_container_highest.default.hex }};

    --button_bg: {{ colors.surface_container_high.default.hex }};
    --button_bg_hover: {{ colors.surface_container_highest.default.hex }};
    --button_bg_down: {{ colors.secondary_container.default.hex }};
    --button_bg_disabled: {{ colors.surface_container.default.hex }};
    --button_border_hover: {{ colors.outline.default.hex }};
    --button_border_focus: {{ colors.primary.default.hex }};

    --tab_bg: {{ colors.surface_container.default.hex }};
    --tab_bg_hover: {{ colors.surface_container_high.default.hex }};
    --tab_bg_down: {{ colors.secondary_container.default.hex }};
    --tab_border_selected: {{ colors.primary.default.hex }};

    --separator_hover: {{ colors.primary.default.hex }};
    --scrollbar_handle: {{ colors.outline_variant.default.hex }};
    --scrollbar_hover: {{ colors.outline.default.hex }};
    --scrollbar_down: {{ colors.on_surface_variant.default.hex }};
    --scrollbar_border: {{ colors.surface.default.hex }};
}
